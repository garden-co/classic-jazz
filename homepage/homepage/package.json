{
  "name": "homepage-jazz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:generate-docs": "pnpm run generate:llm-docs",
    "build": "pnpm check && next build",
    "start": "next start",
    "lint": "pnpm --dir ../.. exec biome check --no-errors-on-unmatched homepage/homepage",
    "check": "concurrently --kill-others-on-fail 'pnpm validate:docs-links' 'pnpm generate:snippet-paths' && concurrently --kill-others-on-fail 'tsc --noEmit -p tsconfig.snippets.json' 'svelte-check --tsconfig tsconfig.snippets.json' && pnpm run generate:llm-docs",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "generate:llm-docs": "node generate-docs/llms-full.mjs && node scripts/add-docs-links-to-agents.mjs && node scripts/generate-user-agents-md.mjs && pnpm test:llm-docs",
    "generate:snippet-paths": "node scripts/generate-snippet-paths.mjs",
    "validate:docs-links": "node scripts/validate-docs-links.mjs",
    "test": "pnpm test:unit",
    "test:unit": "vitest run utils/__tests__",
    "test:watch": "vitest watch utils/__tests__",
    "test:llm-docs": "node --test generate-docs/llms-full.test.mjs generate-docs/classic-warning.test.mjs",
    "test:e2e": "playwright test",
    "postbuild": "pagefind --site .next/server/app --output-path .next/static/chunks/pages/pagefind --exclude-selectors 'nav, header, footer, .not-prose, [data-pagefind-ignore]' --verbose"
  },
  "packageManager": "pnpm@10.16.1",
  "dependencies": {
    "@better-auth/expo": "^1.2.7",
    "@garden-co/design-system": "workspace:*",
    "@headlessui/react": "^2.2.0",
    "@icons-pack/react-simple-icons": "^9.1.0",
    "@mdx-js/loader": "^2.3.0",
    "@mdx-js/react": "^2.3.0",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@shikijs/transformers": "^3.2.1",
    "@shikijs/twoslash": "^3.2.1",
    "@stefanprobst/rehype-extract-toc": "3.0.0",
    "@turf/turf": "^7.1.0",
    "@types/mdx": "^2.0.8",
    "@types/topojson-client": "^3.1.5",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "estree-util-value-to-estree": "^3.3.2",
    "github-slugger": "^2.0.0",
    "gsap": "^3.12.5",
    "jazz-tools": "link:../../packages/jazz-tools",
    "lucide-react": "^0.436.0",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-mdx": "^3.0.0",
    "mdx-bundler": "^10.1.1",
    "mdx-to-md": "^0.5.2",
    "micromark-extension-mdxjs": "^3.0.0",
    "next": "catalog:next",
    "next-themes": "^0.2.1",
    "node-html-markdown": "^1.3.0",
    "qrcode": "^1.5.4",
    "quint-ui": "link:../../packages/quint-ui",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-singleton-hook": "^4.0.1",
    "shiki": "^3.2.1",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:default",
    "@evilmartians/harmony": "^1.4.0",
    "@next/mdx": "^15.3.3",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/typography": "^0.5.16",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitest/ui": "^3.2.3",
    "autoprefixer": "^10",
    "concurrently": "^9.2.1",
    "hast-util-heading-rank": "^3.0.0",
    "hast-util-to-string": "^3.0.1",
    "pagefind": "1.3.0",
    "postcss": "^8",
    "tailwindcss": "^4.1.16",
    "svelte-check": "^4.3.3",
    "turbo": "^2.3.1",
    "typescript": "catalog:default",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vitest": "catalog:default"
  }
}
